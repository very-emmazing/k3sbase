# Pi-Cluster Node-Konfiguration – generiert von: mise run setup -- pi
# Leer lassen; mise run setup -- pi füllt die Werte interaktiv aus und commitet sie.
#
# Voraussetzungen:
#   - Ubuntu auf allen Nodes (kein weiteres Setup nötig)
#   - SSH-Pubkey bereits hinterlegt (ssh-copy-id)
#   - Nodes per SSH erreichbar
#   - Statische IPv6-ULAs auf den Node-Interfaces konfiguriert (IPv6-only-
#     Cluster: k3s --node-ip; Konfiguration der Interfaces selbst liegt
#     außerhalb des Repos, siehe README)

PI_USER="ubuntu"

PI_SERVER=""     # Server-Node  (1x) – Management-IP (SSH), z.B. 192.168.1.10
PI_AGENT_0=""    # Agent-Node   (1x) – z.B. 192.168.1.11
PI_AGENT_1=""    # Agent-Node   (2x) – z.B. 192.168.1.12
PI_AGENT_2=""    # Agent-Node   (3x) – z.B. 192.168.1.13

PI_SERVER_ULA=""   # Server-ULA  (1x) – k3s --node-ip, z.B. fd00:41::10
PI_AGENT_0_ULA=""  # Agent-ULA   (1x) – z.B. fd00:41::11
PI_AGENT_1_ULA=""  # Agent-ULA   (2x) – z.B. fd00:41::12
PI_AGENT_2_ULA=""  # Agent-ULA   (3x) – z.B. fd00:41::13
