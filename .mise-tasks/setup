#!/usr/bin/env bash
#MISE description="Interaktiver Setup-Assistent: age-Key, SOPS-Recipient, Secrets abfragen und verschlüsseln"
set -euo pipefail

CLUSTER="${1:?Fehler: Cluster angeben – z.B.: mise run setup -- local}"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
AGE_KEY_FILE="${HOME}/.config/sops/age/keys.txt"
SOPS_YAML="${REPO_ROOT}/.sops.yaml"

case "${CLUSTER}" in
  local|pi) ;;
  *) printf "Unbekannter Cluster '%s'. Erlaubt: local | pi\n" "${CLUSTER}" >&2; exit 1 ;;
esac

TOTAL=3; [[ "${CLUSTER}" == "pi" ]] && TOTAL=5
STEP=0

if [[ -t 1 ]]; then
  GRN='\033[0;32m' YEL='\033[1;33m' BLU='\033[0;34m' BOLD='\033[1m' RST='\033[0m'
else
  GRN='' YEL='' BLU='' BOLD='' RST=''
fi

ok()   { printf "  ${GRN}✓${RST}  %s\n" "$*"; }
hint() { printf "  ${BLU}→${RST}  %s\n" "$*"; }
warn() { printf "  ${YEL}!${RST}  %s\n" "$*"; }
step() { STEP=$((STEP+1)); printf "\n${BOLD}[%s/%s] %s${RST}\n" "${STEP}" "${TOTAL}" "$1"; }
die()  { printf "\n${YEL}Abbruch: %s${RST}\n" "$*" >&2; exit 1; }

for tool in age-keygen sops; do
  command -v "${tool}" &>/dev/null || die "${tool} nicht gefunden – zuerst: mise install"
done

printf "\n${BOLD}════ k3sbase · Setup [%s] ════════════════${RST}\n" "${CLUSTER}"

# ── [1] age-Schlüssel ─────────────────────────────────────────────────────────
SOPS_YAML_UPDATED=false
step "age-Schlüssel"

if [[ -f "${AGE_KEY_FILE}" ]]; then
  ok "Vorhanden: ${AGE_KEY_FILE}"
else
  hint "Wird lokal generiert – verlässt diese Maschine nicht (niemals ins Repo)"
  mkdir -p "$(dirname "${AGE_KEY_FILE}")"
  age-keygen -o "${AGE_KEY_FILE}"
  chmod 600 "${AGE_KEY_FILE}"
  ok "Generiert: ${AGE_KEY_FILE}"
fi

AGE_PUB="$(grep '^# public key:' "${AGE_KEY_FILE}" | awk '{print $NF}')"
hint "Public Key: ${AGE_PUB}"

# ── [2] .sops.yaml Recipient ──────────────────────────────────────────────────
step "SOPS-Konfiguration (.sops.yaml)"

CURRENT_RCP="$(grep -E '^\s+age:' "${SOPS_YAML}" | awk '{print $2}' | tr -d '"' | head -1 || true)"
if [[ "${CURRENT_RCP}" == "${AGE_PUB}" ]]; then
  ok "Recipient stimmt überein"
else
  [[ -n "${CURRENT_RCP}" ]] && warn "Recipient unterscheidet sich – wird ersetzt (bereits verschlüsselte Secrets neu verschlüsseln!)"
  cat > "${SOPS_YAML}" <<SOPS
# Never commit the age private key (${AGE_KEY_FILE}).
creation_rules:
  - path_regex: clusters/.*\.yaml$
    # Nur data/stringData verschlüsseln: kind/apiVersion/metadata müssen für
    # kustomize build lesbar bleiben, sonst schlägt jeder Build fehl.
    encrypted_regex: ^(data|stringData)$
    age: ${AGE_PUB}
SOPS
  ok ".sops.yaml aktualisiert"
  SOPS_YAML_UPDATED=true
fi

# ── [3] Pi-Node-Konfiguration (nur pi) ───────────────────────────────────────
NODES_ENV_UPDATED=false
if [[ "${CLUSTER}" == "pi" ]]; then
  step "Pi-Node-Konfiguration (clusters/pi/nodes.env)"
  NODES_ENV="${REPO_ROOT}/clusters/pi/nodes.env"

  _nodes_ok() {
    # shellcheck source=/dev/null
    source "${NODES_ENV}" 2>/dev/null || return 1
    [[ -n "${PI_SERVER:-}" && -n "${PI_AGENT_0:-}" && -n "${PI_AGENT_1:-}" && -n "${PI_AGENT_2:-}" ]] || return 1
    [[ -n "${PI_SERVER_ULA:-}" && -n "${PI_AGENT_0_ULA:-}" && -n "${PI_AGENT_1_ULA:-}" && -n "${PI_AGENT_2_ULA:-}" ]]
  }

  if _nodes_ok; then
    # _nodes_ok läuft in dieser Shell (Funktion, keine Subshell) – die Variablen
    # aus nodes.env sind hier bereits gesetzt.
    ok "Bereits konfiguriert: server=${PI_SERVER}  agents=${PI_AGENT_0} ${PI_AGENT_1} ${PI_AGENT_2}"
    ok "ULAs: server=${PI_SERVER_ULA}  agents=${PI_AGENT_0_ULA} ${PI_AGENT_1_ULA} ${PI_AGENT_2_ULA}"
  else
    hint "Voraussetzung: Ubuntu auf allen Nodes, SSH-Pubkey bereits hinterlegt"
    hint "IPv6-only-Cluster: pro Node zusätzlich die statische ULA (k3s --node-ip);"
    hint "die ULA muss bereits auf dem Node-Interface konfiguriert sein (siehe README)"
    echo
    read -r -p "  SSH-User    [ubuntu]: " INPUT_USER
    PI_USER="${INPUT_USER:-ubuntu}"
    read -r -p "  Server-IP    (1x): "   PI_SERVER
    read -r -p "  Agent-IP 1   (1x): "   PI_AGENT_0
    read -r -p "  Agent-IP 2   (2x): "   PI_AGENT_1
    read -r -p "  Agent-IP 3   (3x): "   PI_AGENT_2
    read -r -p "  Server-ULA   (1x): "   PI_SERVER_ULA
    read -r -p "  Agent-ULA 1  (1x): "   PI_AGENT_0_ULA
    read -r -p "  Agent-ULA 2  (2x): "   PI_AGENT_1_ULA
    read -r -p "  Agent-ULA 3  (3x): "   PI_AGENT_2_ULA
    [[ -z "${PI_SERVER}" ]] && die "Server-IP darf nicht leer sein"
    for v in PI_AGENT_0 PI_AGENT_1 PI_AGENT_2 PI_SERVER_ULA PI_AGENT_0_ULA PI_AGENT_1_ULA PI_AGENT_2_ULA; do
      [[ -z "${!v}" ]] && die "${v} darf nicht leer sein"
    done
    cat > "${NODES_ENV}" <<ENV
# Pi-Cluster Node-Konfiguration – generiert von: mise run setup -- pi
PI_USER="${PI_USER}"
PI_SERVER="${PI_SERVER}"
PI_AGENT_0="${PI_AGENT_0}"
PI_AGENT_1="${PI_AGENT_1}"
PI_AGENT_2="${PI_AGENT_2}"
PI_SERVER_ULA="${PI_SERVER_ULA}"
PI_AGENT_0_ULA="${PI_AGENT_0_ULA}"
PI_AGENT_1_ULA="${PI_AGENT_1_ULA}"
PI_AGENT_2_ULA="${PI_AGENT_2_ULA}"
ENV
    ok "nodes.env gesetzt"
    NODES_ENV_UPDATED=true
  fi
fi

# ── [4] Cluster-Settings (nur pi) ─────────────────────────────────────────────
SETTINGS_UPDATED=false
if [[ "${CLUSTER}" == "pi" ]]; then
  step "Cluster-Settings (clusters/pi/cluster-settings.yaml)"
  SETTINGS_YAML="${REPO_ROOT}/clusters/pi/cluster-settings.yaml"
  [[ -f "${SETTINGS_YAML}" ]] || die "${SETTINGS_YAML} fehlt"

  _get_setting() { grep -E "^  $1:" "${SETTINGS_YAML}" | awk '{print $2}' | tr -d '"'; }
  _set_setting() {
    local tmp; tmp="$(mktemp)"
    sed "s|^  $1: \".*\"|  $1: \"$2\"|" "${SETTINGS_YAML}" > "${tmp}" && mv "${tmp}" "${SETTINGS_YAML}"
  }

  # CLUSTER_CIDR/SERVICE_CIDR haben Defaults und werden nicht abgefragt.
  for pair in \
    "PI_DOMAIN|Basis-Domain (z.B. example.org)" \
    "GATEWAY_ULA|Gateway-ULA, ohne Präfixlänge (z.B. fd00:44::1)" \
    "TUNNEL_ID|Cloudflare-Tunnel-ID (leer = später nachtragen)" \
    "ACME_EMAIL|E-Mail für Let's Encrypt (ClusterIssuer)"; do
    key="${pair%%|*}"; prompt="${pair#*|}"
    cur="$(_get_setting "${key}")"
    if [[ -n "${cur}" && "${cur}" != REPLACE_WITH_* ]]; then
      ok "${key} bereits gesetzt: ${cur}"
      continue
    fi
    read -r -p "  ${prompt}: " val
    if [[ -z "${val}" ]]; then
      warn "${key} bleibt Platzhalter – flux-bootstrap verweigert, bis der Wert gesetzt ist"
      continue
    fi
    _set_setting "${key}" "${val}"
    ok "${key} gesetzt"
    SETTINGS_UPDATED=true
  done
fi

# ── [3/5] Cloudflare API Token ────────────────────────────────────────────────
# pi: derselbe Token wird zusätzlich für den cert-manager-Namespace
# verschlüsselt (ClusterIssuer-secretRefs werden nur dort aufgelöst).
CF_SECRET_FILES=("clusters/${CLUSTER}/infrastructure/external-dns-secret.yaml|external-dns")
[[ "${CLUSTER}" == "pi" ]] \
  && CF_SECRET_FILES+=("clusters/pi/infrastructure/cert-manager-secret.yaml|cert-manager")
CF_SECRETS_UPDATED=()
CF_TOKEN=""

step "Cloudflare API Token (external-dns / cert-manager)"

for entry in "${CF_SECRET_FILES[@]}"; do
  CF_SECRET="${entry%%|*}"; CF_NAMESPACE="${entry#*|}"
  if grep -q 'ENC\[' "${REPO_ROOT}/${CF_SECRET}" 2>/dev/null; then
    ok "Bereits SOPS-verschlüsselt – übersprungen: ${CF_SECRET}"
    continue
  fi
  if [[ -z "${CF_TOKEN}" ]]; then
    EXISTING="$(grep 'token:' "${REPO_ROOT}/${CF_SECRET}" | awk '{print $2}' | tr -d '"' | xargs 2>/dev/null || true)"
    if [[ -n "${EXISTING}" ]]; then
      warn "Plaintext-Token gefunden – wird direkt verschlüsselt"
      CF_TOKEN="${EXISTING}"
    else
      hint "Token erstellen unter: https://dash.cloudflare.com/profile/api-tokens"
      hint "  → \"Create Token\" → Template \"Edit zone DNS\""
      hint "  Berechtigungen: Zone:DNS:Edit  (Zone:Zone:Read optional für Autodiscovery)"
      echo
      read -r -s -p "  Token (Eingabe unsichtbar): " CF_TOKEN
      echo
      [[ -z "${CF_TOKEN}" ]] && die "Kein Token eingegeben"
    fi
  fi
  # Plaintext nie in die getrackte Datei schreiben: schlüge sops fehl, läge der
  # Token sonst unverschlüsselt im Repo (ein "git add ." vom Leak entfernt).
  # --filename-override lässt die creation_rules aus .sops.yaml trotz Tempfile
  # auf den Zielpfad matchen.
  TMP_SECRET="$(mktemp)"
  trap 'rm -f "${TMP_SECRET}" "${TMP_SECRET}.enc"' EXIT
  cat > "${TMP_SECRET}" <<YAML
apiVersion: v1
kind: Secret
metadata:
  name: cloudflare-api-token
  namespace: ${CF_NAMESPACE}
stringData:
  token: "${CF_TOKEN}"
YAML
  SOPS_AGE_KEY_FILE="${AGE_KEY_FILE}" sops -e --filename-override "${CF_SECRET}" \
    "${TMP_SECRET}" > "${TMP_SECRET}.enc"
  mv "${TMP_SECRET}.enc" "${REPO_ROOT}/${CF_SECRET}"
  rm -f "${TMP_SECRET}"
  ok "Verschlüsselt: ${CF_SECRET}"
  CF_SECRETS_UPDATED+=("${CF_SECRET}")
done

# ── Commits ───────────────────────────────────────────────────────────────────
_commit() {
  local msg="$1"; shift
  git -C "${REPO_ROOT}" add "$@"
  git -C "${REPO_ROOT}" commit -m "${msg}"
  ok "Committed: ${msg}"
}

HAS_CHANGES=false
[[ "${SOPS_YAML_UPDATED}" == true ]] && HAS_CHANGES=true
[[ "${NODES_ENV_UPDATED}" == true ]] && HAS_CHANGES=true
[[ "${SETTINGS_UPDATED}" == true ]] && HAS_CHANGES=true
[[ ${#CF_SECRETS_UPDATED[@]} -gt 0 ]] && HAS_CHANGES=true

if [[ "${HAS_CHANGES}" == true ]]; then
  printf "\n"
  read -r -p "  Änderungen jetzt committen? (j/N) " REPLY
  if [[ "${REPLY}" =~ ^[jJ]$ ]]; then
    [[ "${SOPS_YAML_UPDATED}" == true ]] && _commit "chore(sops): set age recipient"                  .sops.yaml
    [[ "${NODES_ENV_UPDATED}" == true ]] && _commit "chore(pi): set node ips in nodes.env"            clusters/pi/nodes.env
    [[ "${SETTINGS_UPDATED}" == true ]]  && _commit "chore(pi): set cluster settings"                 clusters/pi/cluster-settings.yaml
    [[ ${#CF_SECRETS_UPDATED[@]} -gt 0 ]] && _commit "feat(${CLUSTER}): add sops-encrypted cloudflare api token" "${CF_SECRETS_UPDATED[@]}"
  else
    printf "\n"; hint "Manuell committen:"
    [[ "${SOPS_YAML_UPDATED}" == true ]] && hint "  git add .sops.yaml && git commit -m 'chore(sops): set age recipient'"
    [[ "${NODES_ENV_UPDATED}" == true ]] && hint "  git add clusters/pi/nodes.env && git commit -m 'chore(pi): set node ips in nodes.env'"
    [[ "${SETTINGS_UPDATED}" == true ]]  && hint "  git add clusters/pi/cluster-settings.yaml && git commit -m 'chore(pi): set cluster settings'"
    [[ ${#CF_SECRETS_UPDATED[@]} -gt 0 ]] && hint "  git add ${CF_SECRETS_UPDATED[*]} && git commit -m 'feat(${CLUSTER}): add sops-encrypted cloudflare api token'"
  fi
fi

printf "\n${BOLD}════ Abgeschlossen ════════════════════════════${RST}\n\n"
hint "Weiter:"
hint "  mise run cluster-up    -- ${CLUSTER}"
hint "  mise run cilium-up     -- ${CLUSTER}"
hint "  mise run flux-bootstrap -- ${CLUSTER}"
printf "\n"
