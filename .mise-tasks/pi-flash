#!/usr/bin/env bash
#MISE description="Alle vier Pi-Nodes über die BMC flashen, Cloud-Init-Pubkey aus ssh-agent"
set -euo pipefail

BMC_HOST="${1:?Fehler: BMC-Host angeben – z.B.: mise run pi-flash -- <bmc-ip> <pfad-zum-image>}"
IMAGE="${2:?Fehler: Pfad zum Ubuntu-Server-Image (arm64, preinstalled-server) angeben}"

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
NODES_ENV="${REPO_ROOT}/clusters/pi/nodes.env"
# shellcheck source=lib/ssh-agent-key.sh
source "${REPO_ROOT}/.mise-tasks/lib/ssh-agent-key.sh"

PI_USER="ubuntu"
# nodes.env existiert zu diesem Zeitpunkt evtl. noch nicht (Flashen kommt vor
# "mise run setup -- pi") – dann bleibt der Ubuntu-Default.
# shellcheck source=/dev/null
[[ -f "${NODES_ENV}" ]] && source "${NODES_ENV}"

command -v tpi >/dev/null || { echo "Fehler: tpi nicht gefunden – zuerst: mise install"; exit 1; }
[[ -f "${IMAGE}" ]] || { echo "Fehler: Image nicht gefunden: ${IMAGE}"; exit 1; }

# tpi >=2.0 verlangt BMC-Auth (TPI_USERNAME/TPI_PASSWORD, von tpi selbst
# gelesen). Ohne diese Env-Vars hängt der erste "tpi power off" am
# interaktiven Passwort-Prompt – mitten in der Slot-Schleife, nicht wiederholbar.
[[ -n "${TPI_USERNAME:-}" && -n "${TPI_PASSWORD:-}" ]] \
  || { echo "Fehler: TPI_USERNAME/TPI_PASSWORD nicht gesetzt – zuerst exportieren (BMC-Zugangsdaten)"; exit 1; }

PUBKEY="$(ssh_agent_pubkey)"

echo "Nodes: BMC=${BMC_HOST}  User=${PI_USER}"
echo

# macOS hat weder losetup (Loop-Devices sind Linux-spezifisch) noch GNU-cp
# (--reflink). hdiutil (macOS-Bordmittel) haengt rohe Images direkt ein und
# mountet FAT-Partitionen automatisch unter /Volumes, kein sudo noetig.
IS_MACOS=false
[[ "$(uname)" == "Darwin" ]] && IS_MACOS=true

# Annahme: Ubuntu-"preinstalled-server"-Image – Partition 1 ("system-boot",
# FAT) trägt cloud-init im NoCloud-Format (user-data-Datei im Root der
# Partition). Anderes Image-Layout: Partitionsnummer unten anpassen.
for slot in 1 2 3 4; do
  echo "=== Slot ${slot} ==="

  # Kein --suffix (GNU-only, BSD-mktemp auf macOS kennt das nicht) – Suffix
  # per Template, das ist auf beiden portabel.
  WORK_IMG="$(mktemp "${TMPDIR:-/tmp}/pi-flash.XXXXXX.img")"
  USERDATA="$(mktemp)"
  MNT="$(mktemp -d)"
  LOOPDEV=""
  HDIUTIL_DEV=""
  cleanup() {
    if [[ "${IS_MACOS}" == true ]]; then
      [[ -n "${HDIUTIL_DEV}" ]] && hdiutil detach "${HDIUTIL_DEV}" &>/dev/null || true
    else
      [[ -n "${LOOPDEV}" ]] && sudo losetup -d "${LOOPDEV}" &>/dev/null || true
      sudo umount "${MNT}" &>/dev/null || true
    fi
    rmdir "${MNT}" &>/dev/null || true
    rm -f "${WORK_IMG}" "${USERDATA}"
  }
  trap cleanup EXIT

  if [[ "${IS_MACOS}" == true ]]; then
    # -c (APFS-Clonefile) statt --reflink=auto; faellt auf Volumes ohne
    # Clonefile-Support (z.B. exFAT) still auf normales Kopieren zurück.
    cp -c "${IMAGE}" "${WORK_IMG}" 2>/dev/null || cp "${IMAGE}" "${WORK_IMG}"
  else
    cp --reflink=auto "${IMAGE}" "${WORK_IMG}"
  fi

  cat > "${USERDATA}" <<CLOUDINIT
#cloud-config
hostname: pi-node-${slot}
users:
  - name: ${PI_USER}
    groups: [sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - ${PUBKEY}
ssh_pwauth: false
CLOUDINIT

  if [[ "${IS_MACOS}" == true ]]; then
    ATTACH_OUT="$(hdiutil attach "${WORK_IMG}")"
    HDIUTIL_DEV="$(awk 'NR==1{print $1}' <<<"${ATTACH_OUT}")"
    BOOT_MOUNT="$(awk '/\/Volumes\// {print $NF; exit}' <<<"${ATTACH_OUT}")"
    [[ -n "${BOOT_MOUNT}" ]] || { echo "Fehler: Boot-Partition wurde von hdiutil nicht automatisch gemountet. hdiutil-Ausgabe:"; echo "${ATTACH_OUT}"; exit 1; }
    cp "${USERDATA}" "${BOOT_MOUNT}/user-data"
    hdiutil detach "${HDIUTIL_DEV}" >/dev/null
    HDIUTIL_DEV=""
  else
    LOOPDEV="$(sudo losetup --show -fP "${WORK_IMG}")"
    sudo mount "${LOOPDEV}p1" "${MNT}"
    sudo cp "${USERDATA}" "${MNT}/user-data"
    sudo umount "${MNT}"
    sudo losetup -d "${LOOPDEV}"
    LOOPDEV=""
  fi

  echo "  flashe …"
  tpi --host "${BMC_HOST}" power off -n "${slot}"
  tpi --host "${BMC_HOST}" flash -n "${slot}" -i "${WORK_IMG}"

  cleanup
  trap - EXIT
  echo "  fertig"
done

printf "\nWeiter mit:\n"
printf "  for n in 1 2 3 4; do tpi --host %s power on -n \"\${n}\"; done\n" "${BMC_HOST}"
